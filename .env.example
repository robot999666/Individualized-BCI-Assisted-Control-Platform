# Copy to .env; never commit real credentials.
DATABASE_URL=mysql+pymysql://als_bci:CHANGE_ME@127.0.0.1:3306/als_bci
ARTIFACT_DIR=../runtime/artifacts
DEMO_DATA_DIR=../sample_data/demo_processed
PRODUCTION=false
SECURE_COOKIE=false
PUBLIC_FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SESSION_HOURS=8
# Optional override; default runtime/eog-env/{Scripts/python.exe or bin/python}.
# EOG_PYTHON=/opt/als-bci/eog-venv/bin/python
# Required only by python -m app.platform.seed; use distinct random values >=12 chars.
BCI_ADMIN_PASSWORD=
BCI_RESEARCHER_PASSWORD=
BCI_CAREGIVER_PASSWORD=
BCI_GUEST_PASSWORD=
# Project knowledge assistant, backend only. Not used by the control loop.
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-v4.1-flash
