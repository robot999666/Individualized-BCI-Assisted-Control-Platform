# ===== 服务 =====
APP_NAME=个体化脑机辅助控制平台
APP_VERSION=0.1.0

# ===== CORS：允许的前端来源，逗号分隔 =====
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===== BCI 冷启动批量推理 =====
BCI_SAMPLING_RATE_HZ=250
BCI_WINDOW_SAMPLES=501
BCI_MAX_DECOMPRESSED_MB=64
BCI_MAX_CONCURRENT_INFERENCES=1
BCI_DEMO_TRIALS=8

# ===== 上传/响应限制 =====
MAX_UPLOAD_MB=20
MAX_DISPLAY_POINTS=12000
MAX_INTENT_WINDOWS=100
